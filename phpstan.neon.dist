includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - config
        - database
    tmpDir: build/phpstan
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            message: '#expects view-string\|null, string given\.#'
            paths:
                - src/Http/Controllers/BlogController.php
                - src/Livewire/Admin/PostIndex.php
                - src/Livewire/Admin/PostForm.php
                - src/Livewire/Admin/CategoryIndex.php
        -
            # Package config is merged into the host's config at boot, so env() here is resolved (and cached) by the host.
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/blog.php
